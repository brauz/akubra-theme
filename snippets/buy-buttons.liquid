{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  BUY BUTTONS
  ----------------------------------------------------------------------------------------------------------------------

  This component is used to show the buy buttons

  ********************************************
  Supported variables
  ********************************************

  * product: the product from which to show the buttons (if empty, a placeholder is displayed)
  * is_bundle: if the product is a bundle
  * show_payment_button: if we show or not the dynamic checkout button
  * atc_button_background: the background of the ATC button
  * atc_button_text_color: the color of the ATC button
  * payment_button_background: the background of the dynamic payment button
  * payment_button_background: the color of the dynamic payment button
  * form_id: if specified, define the form ID linked to this input
  * kit_collection: the collection to which the bundle belongs, if applicable
  * kit_collection_link_text: the text to display for the bundle collection link, if applicable
{%- endcomment -%}

{% comment %} Adds product pricing to pre orders full payment which isn't supported by app (Partial payment is supported) {% endcomment %}
<style>
  .gPreorderSellingPlanValue:first-child label span::after {
    content: " {{ product.selected_or_first_available_variant.price | money }}";
  }
</style>


{%- if product != blank -%}
  {%- liquid
    assign variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first

    if product.gift_card?
      assign show_payment_button = false
    endif
  -%}

  <product-form>
    {%- form 'product', product, id: form_id -%}
      <input
        type="hidden"
        {% if variant_picker_block != blank %}
          disabled
        {% endif %}
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
      >

      {% liquid
        assign button_disabled = false

        if product.selected_or_first_available_variant == null
          assign button_disabled = true
          assign button_content = 'product.general.unavailable_button' | t
        elsif product.selected_or_first_available_variant.available == false
          assign button_disabled = true
          assign button_content = 'product.general.sold_out_button' | t
        elsif is_bundle == true
          for bundle_product in product.metafields.bundle.products.value
            if bundle_product.available == false
              assign button_disabled = true
              assign button_content = 'product.general.sold_out_button' | t
              break
            endif
            assign button_content = 'product.general.add_to_cart_button' | t
          endfor
        else
          if product.template_suffix contains 'pre-order'
            assign button_content = 'product.general.pre_order_button' | t
          else
            assign button_content = 'product.general.add_to_cart_button' | t
          endif
        endif
      %}

      <div class="buy-buttons-stack v-stack gap-4 my-1-0">
        {% if is_bundle %}
          {% assign bundle_products = product.metafields.bundle.products %}
          <input
            type="hidden"
            id="bundle-products-properties"
            name="properties[_bundleProducts]"
          >
        {% endif %}

        <buy-buttons
          class="buy-buttons product-atc__btn {% if show_payment_button %}buy-buttons--has-dynamic{% endif %} {% if product.gift_card? %}my-0-1{% endif %}"
          form="{{ form_id }}"
          data-full-price="{{ product.selected_or_first_available_variant.price }}"
        >
          {%- if show_payment_button and atc_button_background == blank and atc_button_text_color == blank -%}
            {%- assign atc_button_style = 'outline' -%}
          {%- else -%}
            {%- assign atc_button_style = 'solid' -%}
          {%- endif -%}

          {%- render 'button',
            content: button_content,
            type: 'submit',
            disabled: button_disabled,
            style: atc_button_style,
            background: atc_button_background,
            text_color: atc_button_text_color,
            stretch: true
          -%}

          {%- if show_payment_button -%}
            {{- form | payment_button -}}

            <style>
              #{{ form_id }} .shopify-payment-button {
                {%- if payment_button_background != blank and payment_button_background != 'rgba(0,0,0,0)' -%}
                  --button-background: {{ payment_button_background.rgb }};
                {%- endif -%}

                {%- if payment_button_text_color != blank and payment_button_text_color != 'rgba(0,0,0,0)' -%}
                  --button-text-color: {{ payment_button_text_color.rgb }};
                {%- endif -%}

                {%- unless product.selected_or_first_available_variant.available -%}
                  display: none;
                {%- endunless -%}
              }
            </style>
          {%- endif -%}
        </buy-buttons>
      </div>
    {%- endform -%}

    {%- unless product.tags contains 'bis-hidden' -%}
      <div class="klaviyo-bis-trigger"></div>
    {%- endunless -%}

  </product-form>
{%- else -%}
  <buy-buttons class="buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ form_id }}">
    {%- assign button_content = 'product.general.add_to_cart_button' | t -%}
    {%- render 'button',
      content: button_content,
      type: 'submit',
      background: variant_picker_block.settings.atc_button_background,
      text_color: variant_picker.settings.atc_button_text_color,
      stretch: true
    -%}
  </buy-buttons>
{%- endif -%}

{%- unless product.type == 'Gift Cards' or is_bundle == true -%}
  <div class="pdp-additional-buttons">
    <button class="compare-button flex gap-2 justify-center w-full" data-product-handle="{{ product.handle }}">
      {% render 'icon' with 'compare-flag', class: 'compare-button--icon-empty' %}
      {% render 'icon' with 'compare-flag-filled', class: 'hidden compare-button--icon-filled' %}
      <span class="animate-underline">COMPARE STYLES</span>
    </button>
  </div>
{%- endunless -%}

{% if is_bundle == true and kit_collection != empty and kit_collection_link_text != empty %}
  <div class="flex flex-col gap-2 justify-center align-center">
    <a href="{{ kit_collection.url }}" class="pickup-availability--bundle-link link text-xxxxxs mt-4">
      {{ kit_collection_link_text | upcase }}
    </a>
  </div>
{%- endif -%}

<script>
  const compareButton = document.querySelector('.compare-button');

  document.addEventListener('DOMContentLoaded', function() {
    const productHandle = compareButton.getAttribute('data-product-handle');
    if (doesCompareProductExist(productHandle)) {
      compareButton.classList.add('compare-button--active');
    }
  });

  compareButton.addEventListener('click', function() {
    const metafields = {{ product.metafields.custom | json }};

    // first_image uses the second image in the array as the first image is for ads
    const productData = {
      handle: {{ product.handle | json }},
      colour: "{%- render "data-colour-name", product: product -%}",
      first_image: {{ product.media[1].src | json }},
      inner: metafields?.inner,
      outer: metafields?.outer,
      lining: metafields?.lining,
      eyelets: metafields?.eyelets,
      brim: metafields?.brim,
      crown: metafields?.crown,
      crown_type: metafields?.crown_type,
      binding: metafields?.binding,
      year_created: metafields?.year_created,
      similar_style: metafields?.similar_style
    };

    const productHandle = this.getAttribute('data-product-handle');
    if (doesCompareProductExist(productHandle)) {
      removeProductFromCompare(productHandle);
      this.classList.remove('compare-button--active');
    } else {
      addProductToCompare(productData);
      this.classList.add('compare-button--active');
    }
  });
</script>
